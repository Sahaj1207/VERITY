# VERITY — Environment Configuration Template
# Copy to .env for local overrides. NEVER commit production secrets or real .env files to Git.

# Environment & Server Settings
VERITY_ENV=development
VERITY_HOST=0.0.0.0
VERITY_PORT=8000
VERITY_API_VERSION=0.1.0
VERITY_ENABLE_DOCS=true

# Security & Upload Limits
VERITY_MAX_UPLOAD_MB=15.0
VERITY_MAX_TEXT_LENGTH=250000
VERITY_MAX_FILES_PER_CASE=20
VERITY_MAX_EVIDENCE_ITEMS=100
VERITY_MAX_CLAIMS_PER_CASE=200
VERITY_MAX_TRANSACTIONS_PER_CASE=500
VERITY_MAX_CASES_IN_MEMORY=1000

# CORS Allowed Origins (Comma-separated)
VERITY_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
VERITY_LOG_LEVEL=INFO

# Storage & Database Settings (Day 16)
VERITY_DATABASE_URL=sqlite:///data/verity.db
VERITY_DATABASE_POOL_SIZE=10
VERITY_DATABASE_MAX_OVERFLOW=20
VERITY_DATABASE_TIMEOUT=30.0
VERITY_DATABASE_ECHO=false

# Benchmark File Location
VERITY_BENCHMARK_PATH=data/benchmark/ground_truth_cases.json

# AI Extraction Provider (Day 17 — Multimodal Evidence Intelligence)
# Provider type: MOCK (default, no API key needed), GEMINI, OPENAI_COMPATIBLE
VERITY_AI_PROVIDER=MOCK
# Model name for the selected provider
VERITY_AI_MODEL=gemini-3.6-flash
# Environment variable name containing the actual API key (do NOT put the key here)
VERITY_AI_API_KEY_ENV_VAR=GEMINI_API_KEY
# Timeout in seconds for AI provider requests
VERITY_AI_TIMEOUT=30
# To enable live Gemini extraction, set GEMINI_API_KEY in your environment:
# GEMINI_API_KEY=your-actual-api-key-here
